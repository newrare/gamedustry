          "Recruit +{n}": "Recruter +{n}",
          "Recruiting now gives 5 infantry for the same amount of gold.": "Recruter donne maintenant 5 fantassins pour la même somme d'or.",
          "Reserve": "Réserve",
          "Rich mines": "Mines riches",
          "Royal capital": "Capitale royale",
